# Copy to .env (git-ignored) and fill in. Used for scheduled news headline
# distillation via Claude Haiku 4.5. Without it, the News bed shows raw headlines.
ANTHROPIC_API_KEY=sk-ant-...

# Login gate (required — the app refuses to start if either is unset).
# GARDEN_PASSWORD: the single password to sign in. Choose your own; do not commit it.
# FLASK_SECRET_KEY: random secret used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GARDEN_PASSWORD=choose-a-strong-password
FLASK_SECRET_KEY=replace-with-a-long-random-hex-string
